{
  "name": "insidellms-tools",
  "displayName": "insideLLMs Tools",
  "description": "Run insideLLMs harness probes from VS Code/Cursor with Python CodeLens actions.",
  "version": "0.1.0",
  "publisher": "insideLLMs",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dr-gareth-roberts/insideLLMs.git" },
  "packageManager": "npm@10.9.8",
  "engines": {
    "vscode": "^1.90.0",
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "files": ["dist/extension.js", "README.md", "LICENSE"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:insidellms.runProbes"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "insidellms.runProbes",
        "title": "insideLLMs: Run Probes"
      }
    ],
    "configuration": {
      "title": "insideLLMs",
      "properties": {
        "insidellms.harnessConfigPath": {
          "type": "string",
          "scope": "resource",
          "default": "ci/harness.yaml",
          "description": "Harness config file used by the Run Probes command."
        },
        "insidellms.runDir": {
          "type": "string",
          "scope": "resource",
          "default": ".tmp/runs/ide",
          "description": "Run directory path for IDE-triggered harness runs."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "watch": "tsc -w -p .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "verify-package": "node scripts/verify-package.cjs",
    "test:editor": "node scripts/test-editor.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.6.2",
    "typescript": "5.6.3",
    "yauzl": "3.2.0",
    "yazl": "3.3.1"
  }
}
