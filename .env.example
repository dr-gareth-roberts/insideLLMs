# Example environment variables for insideLLMs
# Example names for your shell, direnv, or application secret loader.
# insideLLMs does not automatically load this file.
# NEVER commit real API keys to version control!

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Other providers
COHERE_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Optional: Run configuration
INSIDELLMS_RUN_ROOT=.tmp/runs
